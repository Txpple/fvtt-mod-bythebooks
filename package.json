{
  "name": "fvtt-mod-bythebooks",
  "private": true,
  "type": "module",
  "description": "Development tooling for By the Books (formerly Battle Flow). NOTHING HERE SHIPS — the module is plain ES modules loaded straight from scripts/, with no build step (ARCHITECTURE.md).",
  "scripts": {
    "verify": "npm run check && npm run knip && npm run typecheck && npm run imports && npm run cardreads && npm run lookups && npm run layers && npm run flagedges && npm run coverage && npm run hooks && npm run dispatch && npm run writers && npm run gmsites && npm run clocks && npm run changemodes && npm run serializer && npm run harness && npm run html && npm run cards && npm run rulefolds && npm run pickers && npm run popups && npm run surfaces && npm run registry && npm run identifiers && npm run moments && npm run contracts && npm run manifest && npm run comments && npm run doclinks && npm run test",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "lint": "biome lint ./scripts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "imports": "node tools/check-imports.mjs",
    "cardreads": "node tools/check-card-reads.mjs",
    "lookups": "node tools/check-lookups.mjs",
    "layers": "node tools/check-layers.mjs",
    "flagedges": "node tools/check-flag-edges.mjs",
    "coverage": "node tools/check-coverage-map.mjs",
    "hooks": "node tools/check-hook-order.mjs",
    "dispatch": "node tools/check-hook-dispatch.mjs",
    "writers": "node tools/check-writers.mjs",
    "gmsites": "node tools/check-gm-sites.mjs",
    "clocks": "node tools/check-clocks.mjs",
    "changemodes": "node tools/check-change-modes.mjs",
    "serializer": "node tools/check-serializer.mjs",
    "harness": "node tools/check-harness.mjs",
    "html": "node tools/check-html.mjs",
    "cards": "node tools/check-cards.mjs",
    "rulefolds": "node tools/check-rule-folds.mjs",
    "pickers": "node tools/check-pickers.mjs",
    "popups": "node tools/check-popups.mjs",
    "surfaces": "node tools/check-surfaces.mjs",
    "registry": "node tools/check-registry.mjs",
    "moments": "node tools/check-moments.mjs",
    "contracts": "node tools/contracts.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "comments": "node tools/check-comments.mjs",
    "manifest": "node tools/bump-version.mjs --check",
    "doclinks": "node tools/check-doc-links.mjs",
    "identifiers": "node tools/check-identifiers.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "fvtt-mcp-dnd5e": "file:../fvtt-mcp-dnd5e",
    "knip": "^5.64.0",
    "typescript": "^6.0.3",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Txpple",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Txpple/fvtt-mod-bythebooks.git"
  }
}
